{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=configmanager;Username=configmanager;Password=configmanager"
  },
  "Auth": {
    "Authority": "http://localhost:8080/realms/config-manager",
    "Audience": "config-distribution"
  },
  "Distribution": {
    "PollInterval": "00:00:30",
    "KeepAliveInterval": "00:00:15"
  }
}
