      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "dave",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-config-manager"
      ],
      "groups": [
        "/viewers"
      ]
    }
  ]
}